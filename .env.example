# Copy this file to .env.local and fill in the values. Never commit .env.local.

# GMI Cloud API key. Without it, ReVibe runs on example data and cached results only.
GMI_API_KEY=
# GMI Cloud base URL (OpenAI-compatible). Change it only if your GMI Cloud console shows another URL.
GMI_API_BASE=https://api.gmi-serving.com/v1
# Model name on GMI Cloud. Copy the exact name from your GMI Cloud console.
GMI_MODEL=deepseek-ai/DeepSeek-V3.2

# Oriane API key (private beta, starts with beta_; Oriane > Workspace settings > API keys). Each call uses workspace credits. Leave it empty and upload Oriane CSV exports instead.
ORIANE_API_KEY=
# Oriane API base URL, from the Oriane API docs. Change it only if Oriane tells you to.
ORIANE_API_BASE=https://connect.oriane.xyz

# Set to 1 on stage: no external calls, only the cache and example data.
REVIBE_OFFLINE=0
# Number of top videos per market that the model labels. More videos take more model time.
SCAN_SAMPLE_SIZE=120
# Scan window in days, counted back from the newest video in the export.
SCAN_DAYS=90
